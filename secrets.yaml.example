# secrets.yaml.example — copy this file to "secrets.yaml" and fill in your values:
#
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is git-ignored, so your real credentials never get committed.
# The two ESP32 builds share these keys; the ESP8266 build uses its own (see below).

# Wi-Fi (primary + optional secondary/extender)
wifi_ssid:          "YourWiFiName"
wifi_password:      "YourWiFiPassword"
wifi_ext_ssid:      "YourSecondWiFiName"      # optional fallback AP; reuse the primary if unused
wifi_ext_password:  "YourSecondWiFiPassword"

# ESPHome device security
oregon-all-in-one__api_encryption_key: "GENERATE_A_32BYTE_BASE64_KEY"  # esphome: `Home Assistant` shows this; or run `openssl rand -base64 32`
oregon-all-in-one__ota_password:       "YourOTAPassword"

# Only needed for the ESP8266 build (oregon-esp8266-fs1000a.yaml) — distinct node, distinct keys:
oregon_esp8266__api_encryption_key:    "GENERATE_A_32BYTE_BASE64_KEY"
oregon_esp8266__ota_password:          "YourOTAPassword"

# Source sensors pulled back from Home Assistant (the values that get transmitted).
# These must be entity_ids that actually exist in your HA instance.
#
# Required for the production config (channel 1 = temp + humidity + clock):
oregon_all_in_one__sensor-temp-1: sensor.your_temperature_entity
oregon_all_in_one__sensor-hum-1:  sensor.your_humidity_entity

# UV sensor (UVR128) -> emulated UV index sensor (~73s period).
# Point at your HA UV-index entity. UVR128 transmits an integer 0..25, so round to a
# whole number in HA (e.g. a template sensor) before feeding it here.
oregon_all_in_one__sensor-uv: sensor.uv_index

# Optional — extra TH channels 2-5 (disabled by default).
# Only needed if you enable the matching `extra_channels:` entries (and their source sensors)
# in your build's YAML. Default model rtgn318 (TH + own clock): ch2 0x20, ch3 0x30, ch4 0x40,
# ch5 0x50 — distinct codes, no collisions on a 5-channel base like the BAR989HG.
#oregon_all_in_one__sensor-temp-2: sensor.your_temp_2
#oregon_all_in_one__sensor-hum-2:  sensor.your_hum_2
#oregon_all_in_one__sensor-temp-3: sensor.your_temp_3
#oregon_all_in_one__sensor-hum-3:  sensor.your_hum_3
#oregon_all_in_one__sensor-temp-4: sensor.your_temp_4
#oregon_all_in_one__sensor-hum-4:  sensor.your_hum_4
#oregon_all_in_one__sensor-temp-5: sensor.your_temp_5
#oregon_all_in_one__sensor-hum-5:  sensor.your_hum_5
